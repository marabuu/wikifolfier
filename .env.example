# ============================================================
# Personal D&D Compendium — environment template
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=compendium
POSTGRES_USER=compendium
POSTGRES_PASSWORD=change-me-please

# ---- Django ----
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=True
# The only account allowed to obtain an editor token or change API content.
# Create this account with `python manage.py createsuperuser`.
OWNER_USERNAME=your-owner-username

# Comma separated. In production set to your real domain.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.example
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used when DATABASE_URL is empty (the compose file builds it for you).
# DATABASE_URL=postgresql://compendium:change-me-please@postgres:5432/compendium

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- Nginx / TLS ----
DOMAIN=your-domain.example
HTTP_PORT=80
HTTPS_PORT=443

# ---- Storage ----
MEDIA_ROOT=/app/media

# ---- Importer ----
WIKIDOT_BASE_URL=https://dnd5e.wikidot.com

# ---- Misc ----
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
