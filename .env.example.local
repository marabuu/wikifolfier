# ============================================================
# LOCAL development (no Docker). Copy to .env and adjust.
# Generated for Windows: PostgreSQL local + Django :8000 + Next.js :3000
# ============================================================

# ---- PostgreSQL (local install) ----
POSTGRES_DB=compendium
POSTGRES_USER=compendium
POSTGRES_PASSWORD=compendium_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_ENGINE=django.db.backends.postgresql

# ---- Django ----
DJANGO_SECRET_KEY=dev-only-insecure-key-change-before-deploying-anywhere
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- Importer ----
WIKIDOT_BASE_URL=https://dnd5e.wikidot.com

# ---- Misc ----
TZ=America/Sao_Paulo
LOG_LEVEL=INFO